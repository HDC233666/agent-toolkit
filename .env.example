# ===== 复制本文件为 .env，填入你自己的 Key =====
# .env 已被 .gitignore 忽略，不会上传到 GitHub

# DeepSeek API Key（也可用同名 Windows 环境变量）
DEEPSEEK_API_KEY=

# OpenAI 兼容接口地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名：deepseek-chat（支持 function calling）
DEEPSEEK_MODEL=deepseek-chat

# Agent 最多走多少步（防止死循环）
AGENT_MAX_STEPS=6

# ===== 调用记录存储（可选）=====
# 留空 = 写 data/logs.jsonl（默认，零配置）
# 填了 = 写 MySQL 的 agent_runs / tool_calls 两张表；连不上会自动降级 JSONL
AGENT_DB_HOST=
AGENT_DB_PORT=3306
AGENT_DB_USER=
AGENT_DB_PASSWORD=
AGENT_DB_NAME=agent_toolkit

# ===== SQL 查询工具的数据源（可选，只读）=====
# 留空 = sql_query 工具不可用（会明确报错）
# 填了 = Agent 可对指定库做 SELECT/SHOW 等只读查询
# 推荐指向 rag-knowledge-base 的 rag_kb 库，两个项目就串起来了
SQL_DB_HOST=
SQL_DB_PORT=3306
SQL_DB_USER=
SQL_DB_PASSWORD=
SQL_DB_NAME=rag_kb

# ===== MCP 工具服务器（可选）=====
# data/mcp_servers.json 中列出的 stdio 服务器会在首次使用时自动启动
MCP_ENABLED=1
MCP_SERVERS_FILE=data/mcp_servers.json
MCP_TIMEOUT_SECONDS=20

# 每个 IP 每分钟最多请求数（0 = 关闭）
AGENT_RATE_LIMIT=60
